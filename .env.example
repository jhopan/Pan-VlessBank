# Pan-VlessBank installer env. Copy to .env or export before install.
# ---------- release / location ----------
# VLESSBANK_REPO=jhopan/Pan-VlessBank
# VLESSBANK_RELEASE=latest           # latest atau tag tetap, mis. v0.1.0
# VLESSBANK_DIR=~/pan-vlessbank
# ---------- panel / proxy ----------
# VLESSBANK_WEBUI_PORT=9000          # kosong = installer bertanya
# VLESSBANK_BASE_PORT=1081
# VLESSBANK_BASE_HTTP=0               # 0 = base + 1000
# VLESSBANK_LISTEN=0.0.0.0            # default LAN
# VLESSBANK_AUTH=user:pass            # wajib saat bind LAN
# ---------- runtime ----------
# VLESSBANK_START=1                   # 0 = hanya download dan tulis settings
